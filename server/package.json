{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "prod": "node dist/server.js",
    "seed:users": "tsx --env-file=.env src/seeds/Users.ts",
    "seed:categories": "tsx src/seeds/Categories.ts",
    "seed:products": "tsx src/seeds/Product.ts",
    "seed:superadmin": "tsx --env-file=.env src/seeds/SuperAdmin.ts",
    "seed:permissions": "tsx --env-file=.env src/seeds/Permissions.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "amqplib": "^2.3.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "multer-storage-cloudinary": "^4.0.0",
    "redis": "^6.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
